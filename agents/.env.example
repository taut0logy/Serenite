DATABASE_URL=
# Language models. Any OpenAI-compatible provider: point these at OpenRouter,
# Groq, Together, an OpenAI account, or a local vLLM/Ollama and nothing in the
# code changes. Defaults to OpenRouter.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Per-task model overrides. Leave empty to use the defaults in
# services/llm.py, which are picked for cost against the work each task does:
#   classify  ibm-granite/granite-4.0-h-micro   labelling, closed-set answers
#   converse  qwen/qwen3.7-flash                the assistant: tools, threads
#   compose   mistralai/mistral-nemo            short warm generation
LLM_CLASSIFY_MODEL=
LLM_CONVERSE_MODEL=
LLM_COMPOSE_MODEL=

# Only the Gemini vision path still needs its own provider key.
GROQ_API_KEY=
TAVILY_API_KEY=
GEMINI_API_KEY=
ASTRA_DB_ID=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=