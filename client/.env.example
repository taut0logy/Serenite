# Next.js configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend Configuration
NEXT_PUBLIC_GRAPHQL_URL="${NEXT_PUBLIC_APP_URL}/api/graphql"

DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=1d

# Authentication providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=

# NextAuth.js
NEXTAUTH_URL="${NEXT_PUBLIC_APP_URL}"
NEXTAUTH_SECRET=

# Meet service. JOIN_TOKEN_SECRET must match meet/.env: this app mints join
# tokens with it and the meet service verifies them.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOIN_TOKEN_SECRET=
NEXT_PUBLIC_SFU_URL=http://localhost:4100

# VAPI Voice Assistant
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key

# Assessment LLM wrapper - any OpenAI-compatible provider works.
# Defaults to OpenRouter with a low-cost model if left unset.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
ASSESSMENT_LLM_MODEL=ibm-granite/granite-4.0-h-micro
