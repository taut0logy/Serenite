generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id                String    @id @default(uuid())
  email             String    @unique
  hashedPassword    String?
  role              Role      @default(USER)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  verified          Boolean   @default(false)
  kycVerified       Boolean   @default(false)
  verificationToken String?   @unique
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?

  // Account security
  failedLoginAttempts     Int       @default(0)
  lockedUntil             DateTime?
  verificationTokenExpiry DateTime?

  // Two-factor authentication fields
  twoFactorEnabled Boolean         @default(false)
  twoFactorAuth    TwoFactorAuth?
  trustedDevices   TrustedDevice[]

  profile                Profile?
  assessments            Assessment[]
  encryptionKey          UserEncryptionKey?
  sessions               Session[]
  socialAccounts         SocialAccount[]
  supportGroups          SupportGroup[]          @relation("SupportGroupMembers")
  facilitatedGroups      SupportGroup[]          @relation("SupportGroupFacilitator")
  diaryEntries           DiaryEntry[]
  supportConversation    SupportConversation?    @relation("SupportSeeker")
  claimedConversations   SupportConversation[]   @relation("SupportResponder")
  meetings               Meeting[]               @relation("MeetingParticipants")
  notifications          Notification[]
  messagesSent           Message[]               @relation("Sender")
  messagesReceived       Message[]               @relation("Receiver")
  calendarEvents         CalendarEvent[]
  feedbacks              Feedback[]
  reportsMade            Report[]                @relation("Reporter")
  reportsReceived        ReportTarget[]          @relation("ReportedUser")
  pollsCreated           Poll[]
  pollsVoted             PollVote[]

  posts     Post[]
  comments  Comment[]
  reactions Reaction[]

  recommendations UserRecommendation?
}


model Profile {
  id        String    @id @default(uuid())
  firstName String
  lastName  String
  dob       DateTime?
  bio       String?
  avatarUrl String?
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Assessment {
  id             String @id @default(uuid())
  userId         String
  parameterSetId String

  // Raw responses, encrypted client-side. Server cannot read these.
  encryptedData Bytes?
  iv            Bytes?
  salt          Bytes?

  // Matching vector - theta and standard error per domain
  thetaDepression Float?
  seDepression    Float?
  thetaAnxiety    Float?
  seAnxiety       Float?
  thetaTrauma     Float?
  seTrauma        Float?
  thetaSleep      Float?
  seSleep         Float?
  thetaSocial     Float?
  seSocial        Float?
  thetaSelfWorth  Float?
  seSelfWorth     Float?

  // Anchor scores - published cutoffs (PHQ-9, GAD-7, PC-PTSD-5)
  phq9Raw         Int?
  gad7Raw         Int?
  pcptsd5Raw      Int?
  traumaExposed   Boolean       @default(false)
  overallSeverity SeverityLevel @default(MINIMAL)

  priorities     String[]
  riskFlag       Boolean @default(false)
  riskEscalated  Boolean @default(false)
  qualityFlagged Boolean @default(false)

  isComplete  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isComplete])
  @@index([overallSeverity])
}

// Opt-in only. respondentKey is a random per-session id, not derivable from
// userId, so this stays disconnected from end-to-end-encrypted user data.
model CalibrationResponse {
  id             String   @id @default(uuid())
  respondentKey  String
  itemId         String
  value          Int
  position       Int
  responseTimeMs Int?
  parameterSetId String
  createdAt      DateTime @default(now())

  @@index([itemId])
  @@index([respondentKey])
}

enum SeverityLevel {
  MINIMAL
  MILD
  MODERATE
  SEVERE
}

model UserEncryptionKey {
  id                         String   @id @default(uuid())
  userId                     String   @unique
  // Master Key wrapped by password-derived KEK (AES-KW)
  wrappedMasterKey           Bytes
  kekSalt                    Bytes    // 16-byte PBKDF2 salt
  kekIterations              Int      @default(600000)
  // Master Key wrapped by recovery (safe-word) key
  wrappedMasterKeyByRecovery Bytes?
  recoveryKeyHash            String?  // bcrypt hash of the safe words (for verification only)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserRecommendation {
  id              String   @id @default(uuid())
  userId          String   @unique
  recommendations Json
  generatedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  meta      Json?    // 2FA session metadata (e.g. requiresTwoFactor, otpAttempts)

  // Device metadata for audit trail
  userAgent String?
  ipAddress String?

  // OTP brute-force protection on temp sessions
  otpAttempts Int @default(0)

  meetingSessions MeetingSession[]
}


enum Role {
  ADMIN
  USER
  HOST
  MANAGER
}

enum SupportGroupType {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model SupportGroup {
  id          String  @id @default(uuid())
  shareableId String  @unique @default(cuid()) // Short, shareable ID for joining
  name        String
  description String?

  type SupportGroupType @default(WEEKLY)
  tags String[] // Keep for display/search

  // Seed theta profile (what kind of users this group is for), same 6-domain
  // space as Assessment. Blended toward the member centroid at match time;
  // this is what a group with few or no members is scored against.
  targetThetaDepression Float @default(0)
  targetThetaAnxiety    Float @default(0)
  targetThetaTrauma     Float @default(0)
  targetThetaSleep      Float @default(0)
  targetThetaSocial     Float @default(0)
  targetThetaSelfWorth  Float @default(0)

  // Severity range this group is suitable for
  minSeverity SeverityLevel @default(MILD)
  maxSeverity SeverityLevel @default(SEVERE)

  // Capacity
  maxMembers Int @default(12)

  // A group whose range reaches MODERATE or SEVERE cannot take members, or
  // start an occurrence, without one. Nullable because a MINIMAL/MILD peer
  // group legitimately runs without a facilitator.
  facilitatorId String?
  facilitator   User?   @relation("SupportGroupFacilitator", fields: [facilitatorId], references: [id], onDelete: SetNull)

  // Recurring meeting schedule fields
  meetingDayOfWeek  Weekday?  @default(FRIDAY)
  meetingDayOfMonth Int?
  meetingTime       String? // HH:MM format (e.g., "17:00" for 5 PM)
  nextMeetingDate   DateTime? // Automatically calculated next meeting date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  members   User[]    @relation("SupportGroupMembers")
  meetings  Meeting[]

  @@index([shareableId])
  @@index([name])
  @@index([nextMeetingDate])
  @@index([facilitatorId])
}

model Meeting {
  id             String        @id @default(uuid())
  startTime      DateTime
  endTime        DateTime?
  supportGroupId String?
  supportGroup   SupportGroup? @relation(fields: [supportGroupId], references: [id], onDelete: Cascade)
  participants   User[]        @relation("MeetingParticipants")
  status         MeetingStatus @default(PENDING)
  messages       Message[]
  feedback       Feedback[]
  reports        Report[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  polls          Poll[]
  recordings     Recording[]
  meetingSessions MeetingSession[]
}


enum MeetingStatus {
  PENDING
  ENDED
  RUNNING
}

enum ParticipantStatus {
  PENDING // This is the default status when a user is invited to a meeting
  ACCEPTED // The user has accepted the meeting invitation
  DECLINED // The user has declined the meeting invitation
  MUTED // The user has been muted by the host
  REMOVED // The user has been removed from the meeting by the host
  CAMERA_OFF // The user's camera is turned off by the host
  HAND_RAISED // The user has raised their hand
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status NotificationStatus @default(UNREAD)
  meta   Json?
}

enum NotificationType {
  MEETING_REQUEST
  MEETING_UPDATE
  MEETING_CANCELLED
  MEETING_REMOVED
  MEETING_CAMERA_OFF
  MESSAGE
  POLL_CREATED
  POLL_ENDED
  HAND_RAISED
  HAND_LOWERED
  RECORDING_STARTED
  RECORDING_STOPPED
}

enum NotificationStatus {
  UNREAD
  READ
}

model Message {
  id          String       @id @default(uuid())
  senderId    String
  meetingId   String?
  receiverId  String?
  supportConversationId String?
  replyToId   String?
  replyTo     Message?     @relation("MessageReply", fields: [replyToId], references: [id], onDelete: Cascade)
  replies     Message[]    @relation("MessageReply")
  content     String
  isDeleted   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sender      User         @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  meeting     Meeting?     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  receiver    User?        @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  supportConversation SupportConversation? @relation(fields: [supportConversationId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([meetingId])
  @@index([senderId])
  @@index([supportConversationId])
}

/// A private journal entry.
///
/// `encryptedContent` is AES-GCM ciphertext produced in the browser under the
/// member's master key, the same key the assessment uses. The server cannot
/// read it back: nothing outside the member's session holds the key.
///
/// `mood` and the embedding are derived once, from plaintext that is sent for
/// analysis and never persisted. They are not reversible into the entry, so
/// they are safe to keep in clear. The embedding lives in the vector
/// collection keyed by this row's id and carries no content of its own.
///
/// Entries previously existed only as rows in the langchain vector table,
/// which meant no foreign key, no cascade on account deletion, and ownership
/// expressed only as an unenforced metadata field.
model DiaryEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  encryptedContent Bytes
  iv               Bytes

  /// Derived label shown back to the member. Null until analysis returns, and
  /// null forever if it failed: an entry is saved whether or not it is scored.
  mood       String?
  confidence Float?

  /// The day the entry is about, which is not always the day it was written.
  entryDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, entryDate])
  @@index([userId, createdAt])
}

/// Opened when an assessment escalates on risk, which also bars the member
/// from peer group placement. Any HOST or MANAGER may claim an open
/// conversation; claiming is what turns a queue entry into a responsibility.
/// This is explicitly not an emergency channel, and the member is shown
/// crisis numbers independently of it.
model SupportConversation {
  id       String @id @default(uuid())
  /// One open conversation per member: a second escalation joins the first
  /// rather than starting a parallel thread a responder might miss.
  memberId String @unique
  member   User   @relation("SupportSeeker", fields: [memberId], references: [id], onDelete: Cascade)

  status SupportConversationStatus @default(OPEN)

  claimedById String?
  claimedBy   User?   @relation("SupportResponder", fields: [claimedById], references: [id], onDelete: SetNull)

  /// The assessment that triggered the escalation, for context on open.
  assessmentId String?

  openedAt  DateTime  @default(now())
  claimedAt DateTime?
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt

  messages Message[]

  @@index([status, openedAt])
  @@index([claimedById])
}

enum SupportConversationStatus {
  OPEN
  CLAIMED
  CLOSED
}

model Attachment {
  id        String   @id @default(uuid())
  messageId String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(uuid())
  meetingId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id          String   @id @default(uuid())
  userId      String
  startTime   DateTime
  endTime     DateTime
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id         String   @id @default(uuid())
  reporterId String
  meetingId  String
  reason     String
  createdAt  DateTime @default(now())

  reporter User           @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  meeting  Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  targets  ReportTarget[]
}

model ReportTarget {
  id       String @id @default(uuid())
  reportId String
  userId   String

  report       Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportedUser User   @relation("ReportedUser", fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactorAuth {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret         String?
  otpBackupCodes String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TrustedDevice {
  id          String   @id @default(uuid())
  userId      String
  deviceToken String   @unique
  deviceName  String
  deviceType  String?
  ipAddress   String?
  lastUsed    DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceToken])
  @@index([userId])
}

// Tracks which social OAuth provider accounts are linked to a user
model SocialAccount {
  id         String   @id @default(uuid())
  userId     String
  provider   String   // e.g. "github", "google"
  providerId String   // the provider's user ID
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

// Tracks which specific device session is active in a meeting call.
// Prevents >1 device from the same account joining the same call.
model MeetingSession {
  id            String    @id @default(uuid())
  meetingId     String
  sessionId     String
  userId        String    // denormalized for fast lookup
  joinedAt      DateTime  @default(now())
  leftAt        DateTime?
  isActive      Boolean   @default(true)
  lastHeartbeat DateTime  @default(now()) // updated every 30s by client; stale > 2min = inactive

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([meetingId, sessionId])
  @@index([meetingId, userId, isActive]) // "is any device from userId in this meeting?"
  @@index([lastHeartbeat])               // stale session sweeps
}


model Poll {
  id               String       @id @default(uuid())
  meetingId        String
  question         String
  isActive         Boolean      @default(true)
  isAnonymous      Boolean      @default(false)
  isMultipleChoice Boolean      @default(false)
  createdById      String
  createdAt        DateTime     @default(now())
  endTime          DateTime?
  options          PollOption[]
  votes            PollVote[]
  meeting          Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy        User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model PollOption {
  id     String @id @default(uuid())
  pollId String
  text   String
  votes  Int    @default(0)
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
}

model PollVote {
  id        String   @id @default(uuid())
  pollId    String
  userId    String
  optionIds String[]
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recording {
  id        String    @id @default(uuid())
  meetingId String
  url       String
  startedAt DateTime
  endedAt   DateTime?
  meeting   Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Community feature models
model Post {
  id          String     @id @default(cuid())
  title       String
  content     String     @db.Text
  isAnonymous Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]
  reactions   Reaction[]
  tags        String[]

  @@index([userId])
}

enum ReactionType {
  LIKE
  HEART
  SUPPORT
  HUG
  THANKS
}

model Reaction {
  id        String       @id @default(cuid())
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, type])
  @@index([postId])
  @@index([userId])
}

model Comment {
  id          String   @id @default(cuid())
  content     String   @db.Text
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}
