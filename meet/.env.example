# The meet service: selective forwarding unit and signaling for support sessions.

NODE_ENV=development
LOG_LEVEL=info
SFU_PORT=4100

# Comma separated. Must include the Next.js origin.
CLIENT_ORIGIN=http://localhost:3000

# The same database the Next.js app uses. This service reads meeting and group
# configuration and writes attendance; it never decides who may join.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/serenite

# Must match JOIN_TOKEN_SECRET in client/.env. Serenite mints join tokens with
# it; this service verifies them locally.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOIN_TOKEN_SECRET=

# REQUIRED IN PRODUCTION. listenInfos does not expand 0.0.0.0 into real
# interface addresses, so the ICE candidate address comes from here. Leaving it
# unset in production yields a service that looks healthy and never connects.
MEDIASOUP_ANNOUNCED_ADDRESS=
MEDIASOUP_RTC_BASE_PORT=44440
MEDIASOUP_WORKERS=auto
MEDIASOUP_LOG_LEVEL=warn

# Support groups cap at 12 members.
MAX_PARTICIPANTS=12
SINGLE_MEETING_ENABLED=true
